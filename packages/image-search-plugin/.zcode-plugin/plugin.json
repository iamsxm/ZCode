{
  "name": "image-search",
  "version": "0.1.1",
  "description": "Official ZCode image search MCP server for finding illustrations and reference images.",
  "description_i18n": {
    "en": "Official ZCode image search MCP server for finding illustrations and reference images.",
    "zh-CN": "ZCode 官方搜图 MCP 服务，用于查找插图与参考配图。"
  },
  "author": {
    "name": "Z.ai"
  },
  "license": "Apache-2.0",
  "mcpServers": {
    "image_search": {
      "type": "http",
      "url": "${ZCODE_BASE_URL}/api/v1/mcp/server/image_search",
      "auth": {
        "type": "zcode_official",
        "provider": "jwt_token"
      },
      "timeoutMs": 90000,
      "command": "C:\\Users\\34862\\AppData\\Local\\Programs\\ZCode\\ZCode.exe",
      "args": [
        "C:\\Users\\34862\\AppData\\Local\\Programs\\ZCode\\resources\\glm\\zcode.cjs",
        "__zcode-plugin-host",
        "C:\\Users\\34862\\.zcode\\cli\\plugins\\cache\\zcode-plugins-official\\image-search\\0.1.1\\dist\\mcp\\server.js"
      ],
      "env": {
        "ELECTRON_RUN_AS_NODE": "1",
        "ZCODE_PLUGIN_ID": "image-search@zcode-plugins-official"
      }
    }
  }
}
